image:
  repository: cr.fluentbit.io/fluent/fluent-bit
  pullPolicy: IfNotPresent

serviceAccount:
  create: true
  name: {{ fluentbit_service_account }}

rbac:
  create: true

podSecurityContext:
  fsGroup: 10001

securityContext:
  runAsUser: 10001
  runAsGroup: 10001
  runAsNonRoot: true
  allowPrivilegeEscalation: false
  capabilities:
    drop:
      - ALL

resources:
{{ fluentbit_resources | to_nice_yaml(indent=2) | indent(2, true) }}

service:
  type: ClusterIP
  metricsPort: 2020

serviceMonitor:
  enabled: {{ fluentbit_service_monitor_enabled }}
  interval: 30s
  scrapeTimeout: 10s
  labels:
    release: {{ prometheus_release_label }}

config:
  service: |
    [SERVICE]
        Flush                 1
        Daemon                Off
        Log_Level             {{ fluentbit_log_level }}
        Parsers_File          parsers.conf
        HTTP_Server           On
        HTTP_Listen           0.0.0.0
        HTTP_Port             2020
        Health_Check          On
        storage.path          /var/fluent-bit/state

  inputs: |
    [INPUT]
        Name                  tail
        Path                  /var/log/containers/*.log
        multiline.parser      docker, cri
        Tag                   kube.*
        Refresh_Interval      5
        Mem_Buf_Limit         50MB
        Skip_Long_Lines       On
        DB                    /var/fluent-bit/state/flb.db
        DB.Sync               Normal
        storage.type          filesystem

  filters: |
    [FILTER]
        Name                  kubernetes
        Match                 kube.*
        Merge_Log             On
        Merge_Log_Key         log
        Keep_Log              Off
        K8S-Logging.Parser    On
        K8S-Logging.Exclude   Off

    [FILTER]
        Name                  grep
        Match                 kube.*
        Regex                 $kubernetes['namespace_name'] ^edulearn$

  outputs: |
    [OUTPUT]
        Name                  opentelemetry
        Match                 kube.*
        Host                  {{ otel_collector_host }}
        Port                  {{ otel_collector_otlp_port }}
        Logs_uri              /v1/logs
        tls                   Off
        compress              gzip
        Log_response_payload  False
        Logs_Body_Key         log
        Logs_Trace_Id_Message_Key trace_id
        Logs_Span_Id_Message_Key span_id
        Logs_Severity_Text_Message_Key level
        Logs_Severity_Number_Message_Key severity

  parsers: |
    [PARSER]
        Name        cri
        Format      cri

    [PARSER]
        Name        docker
        Format      json
        Time_Key    time
        Time_Format %Y-%m-%dT%H:%M:%S.%L

env: []

extraVolumes:
  - name: fluentbitstorage
    emptyDir: {}

extraVolumeMounts:
  - name: fluentbitstorage
    mountPath: /var/fluent-bit/state

tolerations:
  - operator: Exists

nodeSelector: {}

affinity: {}