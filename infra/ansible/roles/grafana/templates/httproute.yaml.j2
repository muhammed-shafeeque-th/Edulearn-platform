apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute

metadata:
  name: grafana
  namespace: {{ grafana_namespace }}

spec:

  hostnames:

    - "{{ grafana_hostname }}"

  parentRefs:

    - group: gateway.networking.k8s.io
      kind: Gateway
      namespace: {{ gateway_namespace }}
      name: {{ gateway_name }}
      sectionName: http

    - group: gateway.networking.k8s.io
      kind: Gateway
      namespace: {{ gateway_namespace }}
      name: {{ gateway_name }}
      sectionName: https

  rules:

    - backendRefs:

        - name: {{ grafana_service }}

          port: 80