serviceMonitor:
  enabled: true
  interval: 30s
  labels:
    release: kube-prometheus-stack

replicas: 1

service:
  type: ClusterIP
  labels:
    app.kubernetes.io/component: tracing

persistence:
  enabled: true
  storageClassName: "{{ storage_class }}"
  size: "{{ tempo_storage_size }}"

serviceAccount:
  create: true
  name: tempo

# Pod-level security context (spec.template.spec.securityContext)
securityContext:
  fsGroup: 10001
  runAsUser: 10001
  runAsGroup: 10001
  runAsNonRoot: true

nodeSelector:
      workload: stateful

tolerations:
      - key: workload
        operator: Equal
        value: stateful
        effect: NoSchedule



compactor:
  compaction:
    block_retention: "{{ tempo_retention }}"
  working_directory: /var/tempo/compactor



# Container-level security context (spec.template.spec.containers[*].securityContext)
tempo:
  securityContext:
  allowPrivilegeEscalation: false
  capabilities:
    drop:
      - ALL

  retention: "{{ tempo_retention }}"
  storage:
    trace:
      backend: s3
      s3:
        bucket: "{{ tempo_bucket_name }}"
        endpoint: "s3.{{ aws_region }}.amazonaws.com"
        region: "{{ aws_region }}"


  metricsGenerator:
    enabled: true
    storage:
      path: /var/tempo/generator/wal
    remoteWriteUrl: "http://kube-prometheus-stack-prometheus.monitoring.svc:9090/api/v1/write"

  overrides:
    defaults:
      metrics_generator:
        processors: ["service-graphs", "span-metrics", "local-blocks"]

  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: 0.0.0.0:4317
        http:
          endpoint: 0.0.0.0:4318
    jaeger:
      protocols:
        thrift_compact:
          endpoint: 0.0.0.0:6831
    zipkin:
      endpoint: 0.0.0.0:9411

  resources:
    requests:
      cpu: 200m
      memory: 512Mi
    limits:
      cpu: 1
      memory: 2Gi